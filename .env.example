# Telegram — create a bot with @BotFather; get your chat id from @userinfobot.
TELEGRAM_TOKEN=
ALLOWED_CHAT_ID=

# Where things live.
# The notes vault: holds 01-Projects/, 04-Requests/ and 05-Tasks/.
VAULT_PATH=C:\work\vault
# Project checkouts; a project is PROJECTS_PATH\<name> unless its note sets `path:`.
PROJECTS_PATH=C:\work\projects
# Root of the local nginx/PHP stack (nginx\, php\php-X.Y\), laid out like devcrate.
DEVCRATE_ROOT=C:\devcrate

# Workers.
MAX_WORKERS=3
MAX_BOUNCES=2

# opencode: the bot starts `opencode serve` on this port if nothing answers there.
OPENCODE_URL=http://127.0.0.1:4096
# provider/model as listed by `opencode models`; empty = opencode's default.
OPENCODE_MODEL=

# Claude Code: empty = your default model.
CLAUDE_MODEL=

# Shared branches. Tasks start from <GIT_REMOTE>/<BASE_BRANCH>, fetched at
# planning, at gate 1 and before gate 2. Branches are <BRANCH_PREFIX>/<type>/<id>-<slug>.
# Colleagues' unmerged branches active in the last OVERLAP_DAYS are flagged.
BASE_BRANCH=development
GIT_REMOTE=origin
BRANCH_PREFIX=devflow
OVERLAP_DAYS=14

# Gitignored files/folders a worktree needs to run, copied (files) or
# junctioned (folders) from the main checkout when missing. Comma-separated,
# relative to the project root. The values below suit a CodeIgniter app; adjust per stack.
LINK_PATHS=vendor,.env,application/config/database.php,application/config/config.php

# Paths no agent (opencode or Claude) may read (glob, relative to the worktree). Secrets, not privacy.
DENY_READ=.env,.env.*,application/config/database.php,**/*-key.pem
